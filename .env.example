# UniRig UI Environment Configuration
# Copy this file to .env and configure with your values

# Motion Dataset Configuration (for Deep Motion Editing retargeting)
# ===================================================================

# Google Drive URL or direct download URL for preprocessed motion dataset
# Example: https://drive.google.com/uc?id=YOUR_FILE_ID&export=download
# If not set, motion retargeting features will be disabled
MOTION_DATASET_URL=

# Optional: SHA256 checksum for dataset integrity verification
# Generate with: sha256sum motion_dataset.tar.gz
# If not set, checksum verification will be skipped
MOTION_DATASET_CHECKSUM=

# Motion cache directory (matches Docker volume mount)
# Default: /app/motion_cache
MOTION_CACHE_DIR=/app/motion_cache

# Database Configuration
# ===================================================================
DATABASE_PATH=/app/db_data/unirig_ui.db

# Redis Configuration (Celery broker)
# ===================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Deep Motion Editing Worker Configuration
# ===================================================================
DME_TIMEOUT_SECONDS=90
MAX_RETARGETING_CONCURRENT=1

# GPU Configuration
# ===================================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
